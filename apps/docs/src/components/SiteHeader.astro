---
import Icon from "./Icon.astro";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const links = [
  { href: "/", label: "Overview" },
  { href: "/docs", label: "Docs" },
  { href: "/motion", label: "Motion" },
  { href: "/native", label: "Native" },
  { href: "/practice", label: "Practice" },
];

function isActive(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="page-shell nav-shell">
    <a class="brand" href="/" aria-label="Glass Kit home">
      <img class="brand-logo brand-logo--light" src="/assets/light-mode-logo.png" alt="" />
      <img class="brand-logo brand-logo--dark" src="/assets/dark-mode-logo.png" alt="" />
      <span class="brand-name">Glass Kit</span>
    </a>

    <nav class="top-nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="material-toggle" type="button" data-material-toggle aria-pressed="false">
        <Icon name="glass" />
        <span data-material-label>Liquid</span>
      </button>
      <button class="theme-toggle" type="button" data-theme-toggle>
        <Icon name="moon" />
        <span data-theme-label>Theme</span>
      </button>
    </div>
  </div>
</header>
