{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glass Kit Native Host",
  "version": "0.1.0",
  "identifier": "dev.glasskit.native-host",
  "build": {
    "beforeDevCommand": "npm run dev -w @glasskit/example-settings -- --port 5185",
    "devUrl": "http://127.0.0.1:5185",
    "beforeBuildCommand": "npm run build -w @glasskit/example-settings",
    "frontendDist": "../../example-settings/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glass Kit · Settings",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' data: blob:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:5185 ws://localhost:5185"
    }
  },
  "bundle": {
    "active": false
  }
}
